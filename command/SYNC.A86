; SYNC.A86 -- CP/M-86 track-cache flush for PC-9801 and FM-11.
;
; Both CBIOS variants export the same private FAR-call ABI:
;   0400:3DD8 CACHE_SYNC  -> CF=0 success, CF=1 disk write-back error
; SYNC writes all dirty sectors but keeps valid cache contents.
; Unlike CACHE_RESET, it does NOT invalidate disk/track cache metadata.
;
; Build on either CP/M-86 installation:
;   ASM86 SYNC.A86
;   GENCMD SYNC
; Run from CCP:
;   A>SYNC
;
; Requires the updated CBIOS exporting the ABI; do not use with an
; unrelated CP/M-86 BIOS or old system image.
;
BDOSINT         EQU     0E0h
BIOS_SYS_SEG    EQU     0400h
CACHE_SYNC_OFS  EQU     03DD8h

        CSEG
start:
        call    bios_cache_sync
        jnc     sync_ok
        mov     dx,offset msg_failed
        call    puts
        jmp     exit_program

sync_ok:
        mov     dx,offset msg_ok
        call    puts

exit_program:
        mov     cl,0
        int     BDOSINT
        hlt

; Call FAR ptr16:16 (opcode 9Ah) in the resident BIOS segment.
; Preserve CF through RET so JNC at the caller sees the result.
bios_cache_sync:
        DB      09Ah
        DW      CACHE_SYNC_OFS
        DW      BIOS_SYS_SEG
        ret

puts:
        mov     cl,9
        int     BDOSINT
        ret

        DSEG
        ORG     100h
msg_ok  DB      'SYNC: cache flushed.',0Dh,0Ah,'$'
msg_failed DB  'SYNC: disk write-back failed.',0Dh,0Ah,'$'
        END
